# 中文：根目录与 core/.env 均可加载；core 中同名项优先，进程环境变量优先于文件。
# English: Load root and core/.env; backend entries override root, environment overrides files.

# 中文：默认服务：deepseek / mimo / openai_compatible；只读取所选服务的整组连接配置。
# English: Active service; only its own credential/model/endpoint namespace is selected.
LLM_PROVIDER=deepseek

# 中文：OpenAI 兼容服务的密钥，仅在选择 openai_compatible 时使用。
# English: Secret for the generic compatible service, used only when that service is selected.
OPENAI_API_KEY=
# 中文：兼容服务的 API 根地址，不包含 /chat/completions。
# English: Compatible API base URL without the /chat/completions suffix.
OPENAI_API_BASE=
# 中文：兼容服务提供的模型或部署名，不会自动选择模型。
# English: Explicit model/deployment ID offered by the compatible service.
OPENAI_MODEL=

# 中文：DeepSeek 独立密钥，不向其他服务兜底。
# English: DeepSeek-only secret, never used as another vendor's fallback.
DEEPSEEK_API_KEY=
# 中文：DeepSeek API 根地址；可替换为兼容代理地址。
# English: DeepSeek API base URL; a compatible proxy URL may be substituted.
DEEPSEEK_API_URL=https://api.deepseek.com
# 中文：DeepSeek 模型名；示例值，实际以账号支持的模型为准。
# English: DeepSeek model ID; use one currently available to your account.
DEEPSEEK_MODEL=deepseek-flash

# 中文：MiMo 独立密钥，仅在选择 mimo 时使用。
# English: MiMo-only secret, used when mimo is selected.
MIMO_API_KEY=
# 中文：MiMo API 根地址，保留 /v1，不包含 /chat/completions。
# English: MiMo API base including /v1, without /chat/completions.
MIMO_API_BASE=https://api.xiaomimimo.com/v1
# 中文：MiMo 模型名；示例值，实际以账号支持的模型为准。
# English: MiMo model ID; use one currently available to your account.
MIMO_MODEL=mimo-v2.6-flash

# 中文：决策模型（Decision Model）：决策层使用的独立 OpenAI 兼容端点；不参与聊天供应商选择。
# English: Decision Model — a dedicated OpenAI-compatible endpoint for the decision layer, not chat routing.
# 中文：决策模型 API 密钥。
# English: Decision-model API secret.
DASHSCOPE__API_KEY=
# 中文：决策模型名称（例如 decision-model-preview）。
# English: Decision model id (for example decision-model-preview).
DASHSCOPE__MODEL=
# 中文：OpenAI 兼容根地址，包含 /v1，不包含 /chat/completions。
# English: OpenAI-compatible base URL including /v1, excluding /chat/completions.
DASHSCOPE__MODEL_URL=
# 中文：决策层模式：off 关闭（默认）/ shadow 只记录计划 / enforce 按计划执行路由。
# English: Decision-layer mode: off (default) / shadow (record only) / enforce (apply route).
DECISION_MODE=off
# 中文：单次决策调用超时秒数；超时回退规则决策。
# English: Per-decision timeout in seconds; timeout falls back to rules.
DECISION_TIMEOUT_SECONDS=2
# 中文：决策模型输出 token 上限。
# English: Decision-model output token cap.
DECISION_MAX_TOKENS=1024
# 中文：以下三个可选项优先于服务命名变量；留空按所选服务解析。
# English: These optional overrides win over vendor variables; empty values use the selected vendor.
# 中文：临时覆盖模型名称。 / English: Optional model/deployment override.
LLM_MODEL=
# 中文：临时覆盖所选服务密钥。 / English: Optional selected-vendor secret override.
LLM_API_KEY=
# 中文：临时覆盖 API 根地址。 / English: Optional API base URL override.
LLM_BASE_URL=

# 中文：每次 HTTP 尝试的操作超时秒数；不是整个 Graph 的总时限。
# English: Per-attempt HTTP operation timeout in seconds, not a whole-graph deadline.
LLM_TIMEOUT_SECONDS=60
# 中文：首次请求之外的最大重试次数；2 表示最多尝试 3 次。
# English: Additional retry count; 2 permits at most 3 attempts.
LLM_MAX_RETRIES=2
# 中文：单次模型调用的输出 token 上限，包含推理 token 时以服务定义为准。
# English: Per-call output token cap; inclusion of reasoning tokens follows vendor semantics.
LLM_MAX_TOKENS=4096
# 中文：模型内置联网搜索策略：auto 对受支持模型默认启用，native 仅支持时启用，off 禁用。
# English: Native web-search policy: auto enables supported models, native only when supported, off disables it.
LLM_WEB_SEARCH=auto

# 中文：可选采样温度 0～2，留空使用模型默认值；思考模式可能忽略它。
# English: Optional sampling temperature from 0 to 2; empty keeps model defaults.
LLM_TEMPERATURE=
# 中文：是否在流式响应中请求用量统计；服务支持时再开启。
# English: Request streaming usage statistics only when supported by the service.
LLM_STREAM_USAGE=false
# 中文：服务扩展 JSON；此处关闭思考模式，避免标准消息丢失工具轮次所需的推理字段。
# English: Vendor extension JSON; disable thinking until reasoning-field tool round trips are supported.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 中文：每轮 Graph 最大 super-step 数；包括画像、检索、上下文、模型和工具节点。
# English: Maximum graph super-steps per run, including profile, retrieval, context, model, and tools.
AGENT_MAX_STEPS=25
# 中文：当前工作历史最多保留的完整用户轮次，包含本轮；旧快照不因此删除。
# English: Maximum complete working-history turns including this turn; old snapshots remain stored.
AGENT_HISTORY_MAX_TURNS=20
# 中文：画像、记忆读取与上下文构建各自的超时秒数，失败后普通回答仍可继续。
# English: Timeout for each profile/retrieval/context operation before a plain-answer fallback.
AGENT_CONTEXT_READ_TIMEOUT_SECONDS=3
# 中文：全局个性化开关；false 时本轮请求不能重新开启画像与记忆注入。
# English: Global personalization gate; false cannot be overridden by an individual request.
PERSONALIZATION_ENABLED=true
# 中文：相关记忆返回条数上限；由后续检索服务消费，不代表全库扫描条数。
# English: Retrieved-memory result cap for the forthcoming retrieval service, not a full-scan limit.
MEMORY_TOP_K=8
# 中文：画像和记忆合计的个性化上下文 token 预算，由后续构建服务消费。
# English: Combined profile-and-memory token budget for the forthcoming context builder.
MEMORY_CONTEXT_TOKEN_BUDGET=1200

# 中文：SQLite 快照文件路径，相对 core/；独立于聊天记录、画像和长期记忆业务库。
# English: SQLite checkpoint file relative to core/, separate from business messages/profiles/memory.
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
# 中文：SQLite 写锁等待毫秒数，不是模型超时；范围 1～60000。
# English: SQLite lock-wait timeout in milliseconds, from 1 to 60000; separate from model timeouts.
CHECKPOINT_BUSY_TIMEOUT_MS=5000

# 中文：工具输入与产物根目录，相对 core/；文档每次生成独立 runs/<id>/files/。
# English: Tool input/artifact root relative to core/; each document run has its own files directory.
TOOLS_WORKSPACE_PATH=data/artifacts
# 中文：外部只读 rg 命令的超时秒数，范围 (0, 60]。
# English: External read-only rg command timeout in seconds, greater than 0 and at most 60.
TOOLS_COMMAND_TIMEOUT_SECONDS=10
# 中文：每次 Python 文档进程的超时秒数，范围 (0, 120]。
# English: Timeout per document Python process in seconds, greater than 0 and at most 120.
TOOLS_PYTHON_TIMEOUT_SECONDS=30
# 中文：返回模型的输出字符上限；外部进程超限会终止，范围 256～100000。
# English: Returned character cap; excessive external output terminates the process, 256-100000.
TOOLS_MAX_OUTPUT_CHARS=16000
# 中文：提交的 Python 源码字符数上限，范围 1～100000。
# English: Maximum submitted Python source characters, from 1 to 100000.
TOOLS_MAX_CODE_CHARS=20000
# 中文：单次文件产物总字节数上限，完成后检查；不是 OS 磁盘配额，最大 100 MiB。
# English: Post-execution total artifact byte cap, at most 100 MiB; not an OS disk quota.
TOOLS_MAX_ARTIFACT_BYTES=10485760
# 中文：单次文档生成返回的文件数量上限，范围 1～100。
# English: Maximum returned artifact files per document run, from 1 to 100.
TOOLS_MAX_ARTIFACT_FILES=20

# 中文：保留供后续 Embedding Provider，当前聊天 Provider 不会使用下列三个参数。
# English: Reserved for the future embedding provider; unused by the current chat provider.
# 中文：DashScope 向量模型密钥。 / English: DashScope embedding API secret.
DASHSCOPE_EMBEDDING_API_KEY=
# 中文：向量模型名称，后续需要显式填写。 / English: Explicit embedding model ID for future use.
DASHSCOPE_EMBEDDING_MODEL=
# 中文：向量服务地址，与聊天模型地址分开。 / English: Embedding endpoint, separate from chat.
DASHSCOPE_EMBEDDING_MODEL_URL=

# Background LLM memory learning; saved UI configuration overrides these defaults.
# auto | review | shadow | off. Empty model follows the source conversation model.
MEMORY_MODE=auto
MEMORY_MODEL=
MEMORY_BATCH_SIZE=8
MEMORY_ACTIVE_LIMIT=500
MEMORY_AUTO_CONFIRM_SCORE=0.8
MEMORY_OBSERVED_MIN_THREADS=2
MEMORY_DAILY_TOKEN_BUDGET=50000

# Unified desktop tools; network retrieval stays disabled until explicitly configured.
# 桌面统一工具；网络读取默认关闭，允许列表必须显式配置。
TOOLS_WORKSPACE_FILES_ENABLED=true
TOOLS_EXPORT_DOCUMENT_ENABLED=true
TOOLS_GET_DATETIME_ENABLED=true
TOOLS_RUN_PYTHON_ENABLED=true
TOOLS_WEB_FETCH_ENABLED=false
TOOLS_WEB_FETCH_ALLOWED_DOMAINS=[]
TOOLS_WEB_FETCH_MAX_BYTES=1000000
TOOLS_MAX_CALLS_PER_RUN=12
TOOLS_MAX_TOTAL_OUTPUT_CHARS=64000
TOOLS_MAX_TOTAL_DURATION_SECONDS=120
TOOLS_FAILURE_STREAK_LIMIT=3
TOOLS_MAX_WORKSPACE_READ_BYTES=1048576
TOOLS_MAX_WORKSPACE_SEARCH_BYTES=10485760
TOOLS_MAX_ARTIFACT_RUNS=100

# Explicit composer references are L3 data, independent of the memory budget.
# 输入框显式引用属于 L3，与自动记忆预算独立。
REFERENCES_CONTEXT_CHARS=12000
