{
  "name": "slothy",
  "private": true,
  "version": "0.1.4-exp.1",
  "displayVersion": "0.1.4.1-exp.1",
  "description": "slothy — your personal adaptive agent",
  "author": "slothy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "dev:web": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build:backend": "node electron/build-backend.mjs",
    "build": "npm run build:web && npm run build:backend && node electron/prepare-release.mjs && electron-builder --win nsis --config electron-builder.cjs",
    "build:dir": "npm run build:web && npm run build:backend && node electron/prepare-release.mjs && electron-builder --win --dir --config electron-builder.cjs",
    "preview": "vite preview",
    "start": "electron .",
    "desktop:smoke": "node electron/smoke.mjs",
    "production:audit": "node electron/audit-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-zoom": "^3.0.0",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
